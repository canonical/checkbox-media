plugin: resource
id: intel_huc_active
category_id: intel
user: root
_summary: Checks if HuC is active
environ:
  # necessary for local mode
  XDG_SESSION_TYPE
  XDG_RUNTIME_DIR
estimated_duration: 1
command: huc_check.py

id: intel_check_vainfo_for_generational_capabilities
category_id: intel
flags: simple
user: root
imports: from com.canonical.certification import executable
requires: executable.name == 'vainfo'
_summary: Check that vainfo is reporting the same caps as the media driver docs
estimated_duration: 5
command: silicon_compat.py
