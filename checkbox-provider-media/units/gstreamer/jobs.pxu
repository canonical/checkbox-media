unit: template
template-resource: mediasource
template-filter: mediasource.operation == 'decode'
template-engine: jinja2
template-unit: job
id: gstreamer_{{ codec }}_{{ resolution }}_{{ operation }}_{{ container }}
category_id: gstreamer
flags: simple
_summary: Check {{ codec }} hardware {{ operation }} in {{ resolution }} for gstreamer
requires:
  executable.name == "gst-launch-1.0"
estimated_duration: 1m
run-as-user: true
environ:
  # necessary for local mode
  XDG_SESSION_TYPE
  XDG_RUNTIME_DIR
  NORMAL_USER
command:
  gstreamer-decode "{{ video_url }}" "{{ operation }}" "{{ libva_profile }}" "{{ libva_entrypoint }}"

unit: template
template-resource: mediasource
template-filter: mediasource.operation == 'encode'
template-engine: jinja2
template-unit: job
id: gstreamer_{{ codec }}_{{ resolution }}_{{ operation }}
category_id: gstreamer
flags: simple
_summary: Check {{ codec }} hardware {{ operation }} in {{ resolution }} for gstreamer
requires:
  executable.name == "gst-launch-1.0"
estimated_duration: 1m
run-as-user: true
environ:
  # necessary for local mode
  XDG_SESSION_TYPE
  XDG_RUNTIME_DIR
  NORMAL_USER
command:
  gstreamer-encode "{{ video_url }}" "{{ operation }}" "{{ libva_profile }}" "{{ libva_entrypoint }}" "{{ codec }}" "{{ resolution }}" "{{ gstreamer_encoder }}" "{{ gstreamer_parser }}" "{{ gstreamer_muxer }}" "{{ output_container }}"
