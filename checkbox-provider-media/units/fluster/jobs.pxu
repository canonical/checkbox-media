plugin: shell
id: fluster_h264_vaapi
category_id: fluster
user: root
_summary: fluster framework h264 tests for VA-API
environ:
  # necessary for local mode
  XDG_SESSION_TYPE
  XDG_RUNTIME_DIR
estimated_duration: 15m
command:
  vainfo #logging va-api status
  fluster download -c H.264
  fluster run -d FFmpeg-H.264-VAAPI

plugin: shell
id: fluster_all
category_id: fluster
user: root
_summary: fluster framework all test suites
environ:
  # necessary for local mode
  XDG_SESSION_TYPE
  XDG_RUNTIME_DIR
estimated_duration: 45m
command:
  fluster download
  fluster run