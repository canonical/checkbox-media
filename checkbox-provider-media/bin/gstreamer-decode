#!/usr/bin/env python3
"""Decode a video via GStreamer and verify hardware acceleration via libva trace."""

import argparse
import glob
import os
import re
import subprocess
import sys
import urllib.request
from pathlib import Path


TRACE_GLOB = "/tmp/libva.trace*"
LIB_PATH = "/usr/lib/x86_64-linux-gnu"
GST_LAUNCH = "/usr/bin/gst-launch-1.0"


def cleanup(local_path: Path) -> None:
    local_path.unlink(missing_ok=True)
    for f in glob.glob(TRACE_GLOB):
        Path(f).unlink(missing_ok=True)


def download(url: str, dest: Path) -> None:
    print(f"Downloading {url} ...")
    urllib.request.urlretrieve(url, dest)


def check_hw_acceleration(libva_profile: str, libva_entrypoint: str) -> bool:
    pattern = re.compile(
        rf"profile = {re.escape(libva_profile)},.*entrypoint = {re.escape(libva_entrypoint)}"
    )
    for trace_file in glob.glob(TRACE_GLOB):
        try:
            text = Path(trace_file).read_text(errors="replace")
        except OSError:
            continue
        if pattern.search(text):
            return True
    return False


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Decode a video with GStreamer and verify HW acceleration."
    )
    parser.add_argument("video_url", help="URL of the video to decode")
    parser.add_argument("operation", help="Operation label (e.g. decode)")
    parser.add_argument("libva_profile", help="Expected libva profile number")
    parser.add_argument("libva_entrypoint", help="Expected libva entrypoint number")
    args = parser.parse_args()

    local_path = Path("/tmp") / Path(args.video_url).name

    # Remove any leftover traces from previous runs
    for f in glob.glob(TRACE_GLOB):
        Path(f).unlink(missing_ok=True)

    if not local_path.exists():
        download(args.video_url, local_path)

    env = os.environ.copy()
    env["LD_LIBRARY_PATH"] = LIB_PATH + ":" + env.get("LD_LIBRARY_PATH", "")
    env["LIBVA_DRIVER_NAME"] = "iHD"
    env["LIBVA_DRI3_ENABLE"] = "1"
    env["LIBVA_TRACE"] = "/tmp/libva.trace"
    env["GST_PLUGIN_PATH"] = f"{LIB_PATH}/gstreamer-1.0"

    gst_result = subprocess.run(
        [
            GST_LAUNCH, "-q",
            "filesrc", f"location={local_path}",
            "!", "decodebin",
            "!", "fakevideosink", "sync=false",
        ],
        env=env,
    )

    # Check libva trace logs for HW acceleration
    hw_ok = check_hw_acceleration(args.libva_profile, args.libva_entrypoint)
    if hw_ok:
        print(f"---- [PASS] using HW {args.operation}")
    else:
        print(f"---- [FAIL] not using HW {args.operation}")

    # Check GStreamer exit status
    gst_ok = gst_result.returncode == 0
    if gst_ok:
        print("---- [PASS] gstreamer command completed successfully")
    else:
        print("---- [FAIL] gstreamer returned an error")

    cleanup(local_path)

    if not hw_ok or not gst_ok:
        sys.exit(1)


if __name__ == "__main__":
    main()
